# Two HTTPS sites; certificates are issued automatically (Let's Encrypt).
{$MINIAPP_DOMAIN} {
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv/miniapp
		try_files {path} /index.html
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
}

{$ADMIN_DOMAIN} {
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		X-Robots-Tag noindex
		-Server
	}
}
