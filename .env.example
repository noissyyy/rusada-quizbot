# Copy to .env on the server. NEVER commit .env.

# Telegram — from @BotFather. Revoke and reissue the token if it was ever shared.
BOT_TOKEN=
BOT_USERNAME=Rusada_QuizBot
# optional: short name if you created a Mini App with /newapp (otherwise the Main Mini App is used)
MINIAPP_SHORT_NAME=

# Domains (DNS A-records must point to this server)
MINIAPP_DOMAIN=quiz.example.uz
ADMIN_DOMAIN=admin.example.uz

# Secrets — generate each with:  openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
INTERNAL_TOKEN=

# Your Telegram numeric id(s), comma-separated — become super-admins on first login (ask @userinfobot)
SUPERADMIN_TELEGRAM_IDS=
